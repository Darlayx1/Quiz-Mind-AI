# ==========================================
# QuizMind AI - Environment Variables
# ==========================================
# PERINGATAN KEAMANAN:
# File ini adalah template. JANGAN PERNAH menyimpan API key asli di sini!
# Salin file ini menjadi `.env` lalu masukkan API key asli Anda.
# File `.env` sudah dimasukkan ke `.gitignore` agar tidak pernah ter-push ke GitHub.

# GEMINI_API_KEY: Wajib untuk akses model Gemini 3.8 Flash & Google Grounding.
# Dapatkan API key di: https://aistudio.google.com/
# Di AI Studio runtime, variabel ini diinjeksi secara otomatis.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ENCRYPTION_SECRET: Kunci enkripsi AES-256-GCM server-side untuk proteksi internal payload data.
# Biarkan default atau ubah dengan 32 karakter unik acak.
ENCRYPTION_SECRET="quizmind-ai-super-secret-vault-key-32b"

# APP_URL: URL aplikasi (diisi otomatis oleh AI Studio saat dideploy)
APP_URL="http://localhost:3000"

# PORT: Port server Express
PORT=3000
