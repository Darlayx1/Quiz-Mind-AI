# ==========================================
# QuizMind AI - Environment Variables
# ==========================================
# PERINGATAN KEAMANAN:
# File ini adalah template. JANGAN PERNAH menyimpan API key asli di sini!
# Salin file ini menjadi `.env` lalu masukkan API key asli Anda.
# File `.env` sudah dimasukkan ke `.gitignore` agar tidak pernah ter-push ke GitHub.

# GEMINI_API_KEY: Opsional untuk akses Gemini & Google Grounding melalui key hosting.
# Dapatkan API key di: https://aistudio.google.com/
# Di AI Studio runtime, variabel ini diinjeksi secara otomatis.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Opsional: akses Groq. Key pribadi juga dapat ditambahkan melalui Koneksi AI.
# Dapatkan key di https://console.groq.com/keys. Jangan gunakan variabel VITE_*.
GROQ_API_KEY="MY_GROQ_API_KEY"

# ENCRYPTION_SECRET: Kunci enkripsi AES-256-GCM server-side untuk proteksi internal payload data.
# Wajib untuk vault server: secret acak khusus >=32 karakter dari secret manager hosting.
# Jangan memakai contoh/static secret atau API key sebagai kunci enkripsi.
ENCRYPTION_SECRET=""

# Login pemilik untuk vault lintas perangkat (Node server). Hash: npm run vault:password.
VAULT_USERNAME="owner"
VAULT_PASSWORD_HASH=""
# Pasang disk/volume persisten di hosting. Simpan di luar aset publik.
DATA_DIR=".private-vault"
# Produksi harus memakai HTTPS. Jika memakai reverse proxy tepercaya tunggal:
# TRUST_PROXY="true"
# CORS_ORIGIN="https://alamat-frontend-anda"

# APP_URL: URL aplikasi (diisi otomatis oleh AI Studio saat dideploy)
APP_URL="http://localhost:3000"

# PORT: Port server Express
PORT=3000
